# Proveedor del modelo. Sin clave y sin LLM_PROVIDER el servidor arranca en modo "mock" (sin modelo).
# LLM_PROVIDER=anthropic   # anthropic | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000
# Límites de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TURNOS_SESION=40
MAX_TOKENS_RESPUESTA=2000
LLM_TIMEOUT_MS=60000
RATE_LIMIT_POR_MINUTO=30
# Opcional: protege la API con una clave (el front la pide). Entrégala en el README si la usas.
# ACCESS_KEY=
# Opcional: fija la fecha para evaluar vigencias (YYYY-MM-DD). Por defecto, hoy.
# FECHA_EJECUCION=2026-08-30
